# Copy this file to .env and update the values below.
# NEVER commit your real .env (it is already in .gitignore).

# Application Settings
APP_NAME=ProductAPI
APP_KEY=
# development = shows detailed errors | production = hides them (use this on Render)
APP_ENV=development

# Database Configuration (Aiven MySQL: copy from your service "Overview" page)
DB_DRIVER=mysql
DB_HOST=your-service-name-your-project.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
DB_CHARSET=utf8mb4
DB_PREFIX=

# Aiven requires an encrypted connection
DB_SSL=true
# Optional: verify the server certificate too. Download "CA certificate" from Aiven, then either
#   DB_SSL_CA=/full/path/to/ca.pem
# or paste the PEM text (on Render, a single line with \n between lines is fine):
#   DB_SSL_CA_CERT=-----BEGIN CERTIFICATE-----\n....\n-----END CERTIFICATE-----

# For API  (generate both with:  php lava jwt:generate --show   - they must be different)
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Allowed frontend origin(s), comma separated. No trailing slash.
CORS_ORIGIN=http://localhost:5173

# Set true ONLY on your own computer when running `php lava migration ...`.
# Leave it false/unset on Render.
MIGRATION_ENABLED=false

# Set false to close the public /api/auth/register endpoint
ALLOW_REGISTRATION=true
